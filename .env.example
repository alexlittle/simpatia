# Claude API (recommended — fast, no local GPU needed)
SIMPATIA_PATIENT__BACKEND=anthropic
SIMPATIA_PATIENT__MODEL=claude-haiku-4-5
SIMPATIA_PATIENT__TEMPERATURE=0.8
SIMPATIA_PATIENT__API_KEY=

SIMPATIA_EXAMINER__BACKEND=anthropic
SIMPATIA_EXAMINER__MODEL=claude-sonnet-5
SIMPATIA_EXAMINER__API_KEY=

# Local Ollama alternative for the patient role — uncomment to use instead
# SIMPATIA_PATIENT__BACKEND=openai_compat
# SIMPATIA_PATIENT__MODEL=gemma3:latest
# SIMPATIA_PATIENT__BASE_URL=http://localhost:11434/v1
